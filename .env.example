# --------------------------------------------------------------------------
# ip_claim — environment template. Copy to `.env` and fill in real values.
# .env is gitignored. Never commit secrets.
#
# IMPORTANT: application configuration lives in config/base.yaml, NOT here.
# The environment is used ONLY for secret values, which config/base.yaml pulls
# in explicitly via ${oc.env:VAR}. Do not add scalars/URLs/tunables here — put
# those in config/base.yaml (or a per-environment overlay selected by
# IP_CLAIM_CONFIG).
# --------------------------------------------------------------------------

# ---- Secrets consumed by ip_claim (via ${oc.env:...} in config/base.yaml) -
NEO4J_PASSWORD=change-me-please
LLM_API_KEY=sk-placeholder

# --------------------------------------------------------------------------
# Below: infrastructure/orchestration env consumed by docker-compose / devenv
# (NOT by the ip_claim application itself). Kept here for local convenience.
# --------------------------------------------------------------------------
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=2G
MLFLOW_PORT=5000
HF_TOKEN=
SGLANG_GPU_INDEX=0
SGLANG_MODEL=meta-llama/Llama-3.1-8B-Instruct
SGLANG_PORT=30000
SSH_PASS=
